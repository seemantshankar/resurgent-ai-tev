# OpenRouter credentials for tev-parse enrich (copy to .env and fill in)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
Excel_Enrichment_Model_id=<your-openrouter-model-id>

# Optional OpenRouter attribution headers (see openrouter.ai/docs/app-attribution)
# OPENROUTER_HTTP_REFERER=https://example.com
# OPENROUTER_APP_TITLE=tev-parse
# OPENROUTER_MAX_OUTPUT_TOKENS=32768

# Optional endpoint override (default: https://openrouter.ai/api/v1/chat/completions)
# OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
